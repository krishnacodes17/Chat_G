# =========================================================
# Chat-G Backend — Environment Variables
# Copy this file to `.env` and fill in your real values.
#
#   cp .env.example .env   (Linux / macOS)
#   copy .env.example .env (Windows)
# =========================================================

# Port the Express server listens on
PORT=3000

# MongoDB connection string (MongoDB Atlas recommended)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/chatg

# Secret used to sign JSON Web Tokens (use a long random string)
# Generate one: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-me

# Node environment: development | production
NODE_ENV=development

# Allowed frontend origin for CORS (must match your frontend URL)
FRONTEND_URL=http://localhost:5173

# ---- LLM Providers (Groq is primary, OpenAI is fallback) ----
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key

# Optional fallback key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ---- Product limits ----
# Max AI requests a single user can make per day (resets at server-local midnight)
AI_DAILY_REQUEST_LIMIT=50